<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources of LiteTask.
  - nuget.org for everything (MSTest...).
  - LiteSuite (GitHub Packages of svtica) for LiteSuite.Common only: the package source mapping
    below keeps any other package from coming from there, and LiteSuite.* from anywhere else.
  GitHub Packages asks for a token even for a public package: LITESUITE_PACKAGES_TOKEN.
  - CI: the workflow's GITHUB_TOKEN (packages: read). The LiteSuite.Common package must grant
    read access to this repository (Package settings > Manage Actions access).
  - Workstation: a personal access token (classic) with read:packages only, in the user
    environment variable LITESUITE_PACKAGES_TOKEN. Never commit a token.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="LiteSuite" value="https://nuget.pkg.github.com/svtica/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="LiteSuite">
      <package pattern="LiteSuite.*" />
    </packageSource>
  </packageSourceMapping>
  <packageSourceCredentials>
    <LiteSuite>
      <add key="Username" value="LiteSuite" />
      <add key="ClearTextPassword" value="%LITESUITE_PACKAGES_TOKEN%" />
    </LiteSuite>
  </packageSourceCredentials>
</configuration>
